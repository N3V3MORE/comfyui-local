{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "resolutions"],
  "properties": {
    "version": { "const": 1 },
    "resolutions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "width", "height", "ratio", "orientation"],
        "properties": {
          "id": { "type": "string", "pattern": "^[0-9]+x[0-9]+$" },
          "label": { "type": "string", "minLength": 1 },
          "width": { "type": "integer", "minimum": 64, "multipleOf": 64 },
          "height": { "type": "integer", "minimum": 64, "multipleOf": 64 },
          "ratio": { "type": "string", "pattern": "^[0-9]+:[0-9]+$" },
          "orientation": { "enum": ["square", "portrait", "landscape"] }
        }
      }
    }
  }
}
